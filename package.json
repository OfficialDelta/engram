{
	"name": "engram",
	"version": "1.0.0",
	"description": "Persistent knowledge graph for AI coding agents",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"bin": {
		"engram": "./dist/cli/index.js"
	},
	"files": [
		"dist",
		"!dist/__tests__",
		"!dist/**/*.js.map"
	],
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OfficialDelta/engram.git"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"prepare": "node -e \"try{require('husky')}catch(e){}\"",
		"test:e2e:live": "vitest run src/__tests__/e2e-live.test.ts",
		"prepublishOnly": "npm run build"
	},
	"lint-staged": {
		"*.{ts,js,json}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"keywords": [
		"knowledge-graph",
		"ai",
		"coding-agent",
		"memory",
		"mcp",
		"claude"
	],
	"author": "",
	"license": "MIT",
	"type": "module",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.90.0",
		"@huggingface/transformers": "^3.8.1",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"better-sqlite3": "^12.9.0",
		"sqlite-vec": "^0.1.9",
		"update-notifier": "^7.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.6.0",
		"@types/update-notifier": "^6.0.8",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.2",
		"typescript": "^6.0.3",
		"vitest": "^4.1.4"
	}
}
